# =============================================================================
# Biến môi trường PRODUCTION — TH EDU Companion
# KHÔNG điền giá trị thật vào file nào trong repo. Giá trị thật đặt ở:
#   Vercel → Project → Settings → Environment Variables (chọn môi trường "Production").
# Nếu cần file trên máy: copy thành .env.production.local (đã nằm trong .gitignore).
# `npm run build` tự kiểm tra (scripts/check-env.mjs): sai vai trò khoá / biến bí mật mang tiền tố NEXT_PUBLIC_
# → build DỪNG; sau build dò giá trị bí mật trong JS gửi xuống trình duyệt.
# =============================================================================

# -----------------------------------------------------------------------------
# A. CÔNG KHAI (tiền tố NEXT_PUBLIC_) — được nhúng vào JavaScript gửi xuống trình duyệt.
#    Chỉ đặt giá trị KHÔNG bí mật ở đây.
# -----------------------------------------------------------------------------
# Supabase → Project Settings → API → Project URL (https://)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → API Keys → anon / publishable key. Công khai được: dữ liệu được bảo vệ bởi RLS.
# TUYỆT ĐỐI không dán khoá service_role vào đây (build sẽ báo lỗi).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Thông báo đẩy — khoá CÔNG KHAI VAPID (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Tuỳ chọn: ảnh nền bản đồ cơ sở từ nhà cung cấp trả phí (MapTiler / Stadia…), dạng https://…/{z}/{x}/{y}.png?key=…
# Khoá bản đồ là khoá công khai (giới hạn theo tên miền tại nhà cung cấp). Bỏ trống → OpenStreetMap, dự phòng Esri.
NEXT_PUBLIC_MAP_TILE_URL=

# -----------------------------------------------------------------------------
# B. CHỈ SERVER — không có tiền tố NEXT_PUBLIC_, Next.js không bao giờ đưa xuống trình duyệt.
#    Module dùng các biến này có `import "server-only"` → import nhầm vào component client sẽ lỗi build.
# -----------------------------------------------------------------------------
# Supabase → API Keys → service_role / secret key. BỎ QUA RLS — toàn quyền database.
# Trên Vercel: tick "Sensitive" để không ai xem lại được giá trị sau khi lưu.
SUPABASE_SERVICE_ROLE_KEY=
# Thông báo đẩy — khoá RIÊNG VAPID + email liên hệ
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
# Secret gọi /api/push/dispatch, /api/cron/*, webhook ngân hàng, /api/health chi tiết (mỗi cái ≥ 32 ký tự ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
PUSH_DISPATCH_SECRET=
CRON_SECRET=
PAYMENT_WEBHOOK_SECRET=
HEALTH_CHECK_SECRET=

# -----------------------------------------------------------------------------
# C. TUỲ CHỌN (chỉ server)
# -----------------------------------------------------------------------------
# Trợ lý ảo / tổng kết tháng bằng AI
ANTHROPIC_API_KEY=
# Rate limit nhanh hơn khi nhiều instance (bỏ trống → dùng bảng rate_limits trên Supabase)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Gửi tin Zalo ZNS / SMS qua webhook
MESSAGING_WEBHOOK_URL=
MESSAGING_WEBHOOK_SECRET=
MESSAGING_CHANNELS=zalo_zns
MESSAGING_EVENTS=
# Báo cáo tuần tự động (tối Chủ nhật 20:00 — vercel.json → /api/cron/weekly-report, xác thực bằng CRON_SECRET)
# Gửi thêm email qua Resend (https://resend.com): khoá API + địa chỉ gửi đã xác minh tên miền. Người nhận mặc định = email
# đăng nhập của mọi quản trị viên; hoặc liệt kê (phân cách dấu phẩy) ở REPORT_EMAIL_TO.
RESEND_API_KEY=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=
# Tên miền của app (link "Xem phân tích đầy đủ" trong email). Bỏ trống trên Vercel → dùng tên miền production của project.
NEXT_PUBLIC_APP_URL=
# Giám sát lỗi (docs/backup-disaster-recovery.md)
SENTRY_DSN=
# Mặc định production tự bật ghi lỗi; đặt 0 để tắt hẳn. NEXT_PUBLIC_APP_VERSION: tên phiên bản hiển thị (mặc định = commit Vercel)
MONITORING_ENABLED=
NEXT_PUBLIC_MONITORING_ENABLED=
NEXT_PUBLIC_APP_VERSION=
# (Vercel tự đặt: NODE_ENV, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA — không cần khai báo)
