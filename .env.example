# Supabase — lấy tại Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Chỉ dùng phía server (scripts/admin tasks). KHÔNG BAO GIỜ expose ra client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Trợ lý ảo cho phụ huynh (Claude API) — chỉ dùng phía server. Bỏ trống = ẩn nút "Hỏi trợ lý".
# Lấy khoá tại https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=

# Web Push — thông báo đẩy lên điện thoại. Tạo khoá: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@thedu.vn
# Bí mật cho POST /api/push/dispatch (Supabase Database Webhook / cron) — chuỗi ngẫu nhiên ≥ 32 ký tự
PUSH_DISPATCH_SECRET=

# Zalo ZNS / SMS — webhook trung gian (Edge Function, n8n, nhà cung cấp ZNS…). Bỏ trống = tắt.
MESSAGING_WEBHOOK_URL=
# Chuỗi bí mật ≥ 32 ký tự để ký HMAC-SHA256 (header X-THEDU-Signature)
MESSAGING_WEBHOOK_SECRET=
# Kênh: zalo_zns | sms | zalo_zns,sms
MESSAGING_CHANNELS=zalo_zns
# Loại thông báo gửi ra ngoài (cách nhau dấu phẩy)
MESSAGING_EVENTS=attendance,leave_decided,fee_issued

# Webhook biến động số dư ngân hàng (SePay: API Key · Casso: Khoá bảo mật) → POST /api/payments/webhook — chuỗi ngẫu nhiên ≥ 16 ký tự
PAYMENT_WEBHOOK_SECRET=
# Bí mật cho cron ngoài (/api/cron/fee-reminders, /api/push/dispatch) — tuỳ chọn
CRON_SECRET=

# Rate limiting (chống spam / dò mật khẩu) — tuỳ chọn. Bỏ trống → dùng bảng rate_limits trên Supabase (cần SUPABASE_SERVICE_ROLE_KEY).
# Upstash Redis (https://console.upstash.com → REST API) nhanh hơn khi chạy nhiều instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Giám sát vận hành (docs/backup-disaster-recovery.md)
# Sentry — tuỳ chọn: lỗi client + server được gửi thêm sang Sentry (https://sentry.io → Project → Client Keys → DSN)
SENTRY_DSN=
# Xem chi tiết /api/health (Authorization: Bearer <secret>), ≥ 16 ký tự. CRON_SECRET cũng dùng được.
HEALTH_CHECK_SECRET=
# Ghi nhật ký lỗi: mặc định chỉ bật ở production. 1 = ép bật khi dev, 0 = tắt hẳn.
MONITORING_ENABLED=
NEXT_PUBLIC_MONITORING_ENABLED=
