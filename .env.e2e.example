# Sao chép thành .env.e2e (đã có trong .gitignore) rồi điền. Xem tests/README.md.
# Khuyến nghị: trỏ app (.env.local) vào project Supabase THỬ NGHIỆM khi chạy E2E, không dùng dữ liệu thật của trung tâm.

# Bỏ trống → Playwright tự build + chạy bản production ở cổng E2E_PORT. Điền → test vào server có sẵn / bản staging.
E2E_BASE_URL=
E2E_PORT=3100

# Tài khoản test (email hoặc SĐT)
E2E_PARENT_LOGIN=
E2E_PARENT_PASSWORD=
E2E_TEACHER_LOGIN=
E2E_TEACHER_PASSWORD=

# Kịch bản điểm danh: học sinh thuộc lớp của giáo viên test VÀ là con của phụ huynh test
E2E_STUDENT_NAME=
# Tuỳ chọn: lớp (khi giáo viên có nhiều lớp), id bé (khi phụ huynh có nhiều con)
E2E_CLASS_KEY=
E2E_CHILD_ID=
# 1 = cho phép kịch bản GHI dữ liệu (điểm danh rồi khôi phục)
E2E_ALLOW_WRITES=0
