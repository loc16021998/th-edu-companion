# Sao chép thành .env.e2e (đã có trong .gitignore) rồi điền. Xem tests/README.md.
# Kiểm thử chạy trên project Supabase THỬ NGHIỆM riêng — không bao giờ dùng project dữ liệu thật của trung tâm.

# ---- Project Supabase thử nghiệm (Project Settings → Data API / API Keys) ----
# Có giá trị → Playwright tự chạy app với project này (build ra .next-e2e, không đụng .env.local / bản build thật).
# Chưa có → các kịch bản cần đăng nhập tự BỎ QUA.
E2E_SUPABASE_URL=
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
# Tuỳ chọn: Account → Access Tokens. Có → `npm run e2e:setup` tự nạp schema + dữ liệu test (khỏi dán SQL tay).
E2E_SUPABASE_ACCESS_TOKEN=
# Hoặc (token không có quyền chạy SQL): chuỗi kết nối Postgres của project thử nghiệm — nút Connect → "Session pooler",
# thay [YOUR-PASSWORD] bằng mật khẩu database. `npm run e2e:setup` dùng nó để nạp schema + dữ liệu test.
E2E_DB_URL=

# Điền → test vào server có sẵn / bản deploy staging (bỏ qua bước tự build). Bỏ trống → tự chạy ở cổng E2E_PORT.
E2E_BASE_URL=
E2E_PORT=3100

# ---- Tài khoản test (tạo bởi supabase/seed/demo.sql + supabase/seed/e2e.sql — chỉ có trên project thử nghiệm) ----
E2E_PARENT_LOGIN=phuhuynh.demo@th-edu.local
E2E_PARENT_PASSWORD=Demo@2026
E2E_TEACHER_LOGIN=giaovien.demo@th-edu.local
E2E_TEACHER_PASSWORD=Demo@2026
E2E_ADMIN_LOGIN=quantri.e2e@th-edu.local
E2E_ADMIN_PASSWORD=Demo@2026

# Học sinh thuộc lớp của giáo viên test VÀ là con của phụ huynh test (bé An trong dữ liệu demo)
E2E_STUDENT_NAME=Nguyễn Minh An
# Lớp (giáo viên test có 2 lớp) và id bé (phụ huynh test có 2 con)
E2E_CLASS_KEY=CS1_XALA:K1A
E2E_CHILD_ID=d1000000-0000-4000-8000-000000000001
# 1 = cho phép kịch bản GHI dữ liệu (điểm danh rồi khôi phục, đặt lịch hẹn rồi huỷ) — chỉ đặt 1 trên project thử nghiệm
E2E_ALLOW_WRITES=1
